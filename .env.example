# Sao chép thành .env (KHÔNG commit file .env). Bot đọc file này qua bot/chay-bot.ps1.

# Zalo Bot: token lấy từ Zalo Bot Creator (tin nhắn "Khởi tạo Bot thành công")
ZALO_BOT_TOKEN=

# Apps Script web app của file Google Sheets lớp (xem bot/apps-script/HUONG-DAN.md)
GVCN_APPS_SCRIPT_URL=
# Khoá bí mật giữa plugin và Apps Script: chuỗi ngẫu nhiên >= 24 ký tự.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
GVCN_APPS_SCRIPT_SECRET=

# Khoá model AI: điền ít nhất một khoá
ZAI_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
